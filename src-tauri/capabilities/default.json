{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and launcher windows",
  "windows": ["main", "launcher"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-set-focus",
    "core:window:allow-minimize"
  ]
}
