{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "N1_Recipe",
  "version": "0.2.1",
  "identifier": "com.snipdeck.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "N1_Recipe",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "transparent": false,
        "decorations": true,
        "resizable": true,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
